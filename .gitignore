# --- MATLAB -----------------------------------------------------------------
*.asv
*.m~
*.autosave
slprj/
codegen/

# Intermediate object files from building MEX.
*.o
*.obj

# Compiled MEX binaries are platform-specific. The ones we can ship are
# tracked deliberately -- see mex/README.md -- so only stray builds elsewhere
# in the tree are ignored.
*.mexw32
*.mexglx
!mex/*/bin/*/*.mexw64
!mex/*/bin/*/*.mexa64
!mex/*/bin/*/*.mexmaci64
!mex/*/bin/*/*.mexmaca64
!src/*/*.mexw64
!mex/DepthMapBinIO.mexw64

